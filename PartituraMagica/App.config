<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add type="System.Diagnostics.TextWriterTraceListener" name="logFile" traceOutputOptions="DateTime" initializeData="log.txt"/>
      </listeners>
    </trace>
  </system.diagnostics>
  <appSettings>
    <!-- red, green, blue for example '255,255,255'-->
    <add key="player.paperColor" value="255,255,255"/>
    <add key="player.invertColors" value="false"/>
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
