<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add type="System.Diagnostics.TextWriterTraceListener" name="logFile" 
             traceOutputOptions="DateTime" initializeData="log.txt" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>