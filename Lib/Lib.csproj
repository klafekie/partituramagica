<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PartituraMagica.Lib</RootNamespace>
    <!-- The assembly name is used by the Lamar assembly scans in the app and in the tests. -->
    <AssemblyName>ClassLibrary1</AssemblyName>
    <!-- Properties\AssemblyInfo.cs holds the assembly attributes (incl. InternalsVisibleTo). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2020.3.0" />
    <PackageReference Include="Lamar" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not part of the old project file, never compiled. -->
    <Compile Remove="Playing\INavigationToolStrip.cs" />
  </ItemGroup>

</Project>
